# Environment file for docker-compose.whitelabel.yml — one per white-label
# deployment. Copy to `.env.whitelabel` (gitignored) and fill it in, then:
#
#   docker compose -f docker-compose.whitelabel.yml --env-file .env.whitelabel build
#   docker compose -f docker-compose.whitelabel.yml --env-file .env.whitelabel up -d
#
# This is the union of backend/.env.example and frontend/.env.example — the
# --env-file flag makes it serve both: docker-compose.whitelabel.yml's
# `env_file: .env.whitelabel` reads it for the backend container's runtime
# env, AND `${VITE_API_URL}` etc. in that same file's build `args:` resolve
# from it too. backend/.env.example and frontend/.env.example still exist
# separately for local (non-Docker) `npm run dev` work — keep this file in
# sync with them by hand if either changes.
#
# See docs/WHITE_LABEL_DEPLOYMENT.md for the full walkthrough (creating your
# own Google/Instagram OAuth app + Razorpay account, registering the instance
# for central tracking, etc.).

# ── Compose-level ────────────────────────────────────────────────────────────
# Host ports docker-compose publishes the two services on.
BACKEND_PORT=3000
FRONTEND_PORT=8080

# ── Backend runtime (backend/src) ────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/eventsh
PORT=3000
FRONTEND_BASE_URL=
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CALLMEBOT_API_KEY=
GEOAPIFY_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SHOPKEEPER_REDIRECT_URI=
GOOGLE_ORGANIZER_REDIRECT_URI=
GOOGLE_BUYER_REDIRECT_URI=
GOOGLE_MEMBER_REDIRECT_URI=
GOOGLE_VOLUNTEER_REDIRECT_URI=

RAZORPAY_PARTNER_KEY_ID=
RAZORPAY_PARTNER_SECRET=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=

CORS_ORIGINS=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
SUPPORT_EMAIL=

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_ROUTER_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=
GROQ_ROUTER_MODEL=
SARVAM_API_KEY=

WHATSAPP_ENABLED=false
WHATSAPP_OTP_ENABLED=false

EMAIL_CONFIG_ENC_KEY=

# MUST set both before first `up` — see backend/src/seed/seed.ts.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Central tracking — leave all three blank to opt this instance out.
# Otherwise, register it first (POST /platform-registry/instances on the
# eventsh.com deployment) to get instanceId + licenseKey.
PLATFORM_REGISTRY_URL=
INSTANCE_ID=
INSTANCE_LICENSE_KEY=

# ── Frontend build args (frontend/, baked in at `docker compose build`) ──────
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_APPYFLOW_KEY_SECRET=
VITE_PUBLIC_BASE=
