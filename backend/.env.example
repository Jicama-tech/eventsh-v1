# Backend environment template. Copy to backend/.env for local (non-Docker)
# development, or use .env.whitelabel.example at the repo root instead when
# deploying via docker-compose.whitelabel.yml (see docs/WHITE_LABEL_DEPLOYMENT.md).
#
# Vars marked [WHITE-LABEL] below are the ones a NEW single-tenant deployment
# must set to its own values — everything else has a working default that's
# safe to leave as-is (or is optional).

# ── MongoDB ──────────────────────────────────────────────────────────────────
# [WHITE-LABEL] point this at the tenant's own database — this is the whole
# basis of data isolation between deployments.
MONGO_URI=mongodb://127.0.0.1:27017/eventsh-dev

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3000
# [WHITE-LABEL] the tenant's own frontend origin — used to build every
# login/support/dashboard link sent in emails (see mail.service.ts,
# auth.controller.ts, stalls.service.ts, sponsors.service.ts, etc.).
FRONTEND_BASE_URL=https://eventsh.com
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CALLMEBOT_API_KEY=
GEOAPIFY_KEY=

# ── OAuth (placeholders) ─────────────────────────────────────────────────────
# [WHITE-LABEL] each customer brings their OWN Google/Instagram OAuth app —
# consent screens and redirect URIs must point at the tenant's own domain.
# Redirect URIs below must be registered as Authorized redirect URIs on that
# tenant's Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SHOPKEEPER_REDIRECT_URI=
GOOGLE_ORGANIZER_REDIRECT_URI=
GOOGLE_BUYER_REDIRECT_URI=
# Eventfront "Become a member" popup OAuth callback.
GOOGLE_MEMBER_REDIRECT_URI=
GOOGLE_VOLUNTEER_REDIRECT_URI=

# [WHITE-LABEL] the tenant's own Razorpay account — payments settle to them,
# not to eventsh's account.
RAZORPAY_PARTNER_KEY_ID=
RAZORPAY_PARTNER_SECRET=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=

# [WHITE-LABEL] comma-separated list of origins allowed to call this API —
# must include the tenant's own frontend origin(s), e.g.
# "https://app.customer.com,https://customer.com". Leave unset on the
# eventsh.com deployment itself (falls back to its own hardcoded list).
CORS_ORIGINS=

# ── Email (nodemailer) ───────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# [WHITE-LABEL] where internal notifications (e.g. "new role approval
# request") go, and the support contact shown in transactional emails.
# Defaults to eventsh's own addresses if unset.
ADMIN_EMAIL=admin@eventsh.com
SUPPORT_EMAIL=support@eventsh.com

# ── AI Chatbot — keys borrowed from kioscart ─────────────────────────────────
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_ROUTER_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=
GROQ_ROUTER_MODEL=
SARVAM_API_KEY=

# WhatsApp phase-out: notifications/tickets go via email only. [WHITE-LABEL]
# leave both false for a new deployment — WhatsApp session state
# (whatsapp_auth/) is per-deployment and needs its own pairing if enabled.
WHATSAPP_ENABLED=false
WHATSAPP_OTP_ENABLED=false

# Encryption key for secrets at rest (organizer SMTP passwords). [WHITE-LABEL]
# generate a fresh random value per deployment — changing it later invalidates
# any saved passwords (organizers just re-enter them in Settings).
EMAIL_CONFIG_ENC_KEY=

# ── Seed admin (first boot only — src/seed/seed.ts) ──────────────────────────
# [WHITE-LABEL] MUST set both before first boot on a fresh deployment, or it
# gets seeded with the same known admin login every eventsh instance defaults
# to (admin@eventsh.com / admin123).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Central tracking (platform-registry / platform-sync) ────────────────────
# [WHITE-LABEL] leave ALL THREE unset on the eventsh.com deployment itself —
# it's the receiving end of the registry, not a reporting instance. Set all
# three on a white-label deployment to report basic usage/user data back to
# the central Super Admin. instanceId + licenseKey come from registering
# this deployment first: POST /platform-registry/instances on the
# eventsh.com deployment (see docs/WHITE_LABEL_DEPLOYMENT.md).
PLATFORM_REGISTRY_URL=
INSTANCE_ID=
INSTANCE_LICENSE_KEY=
