# Frontend environment template. Copy to frontend/.env for local dev, or use
# .env.whitelabel.example at the repo root instead when deploying via
# docker-compose.whitelabel.yml (see docs/WHITE_LABEL_DEPLOYMENT.md).
#
# IMPORTANT: every var here is baked into the JS bundle at BUILD time (Vite's
# `define`/`import.meta.env` — see vite.config.ts), not read at runtime. A
# white-label deployment needs its own build with its own values, not a
# shared build reused with a swapped env file.

# [WHITE-LABEL] the tenant's own backend origin.
VITE_API_URL=http://localhost:3000

# [WHITE-LABEL] the tenant's own Google OAuth client ID — must match the one
# registered against their own OAuth app (see backend/.env.example).
VITE_GOOGLE_CLIENT_ID=

VITE_APPYFLOW_KEY_SECRET=

# Production builds only (`vite build`, mode=production) — sets Vite's `base`
# so hashed asset URLs in the built HTML point at the tenant's own domain
# instead of the "https://eventsh.com/" default. [WHITE-LABEL] set to the
# tenant's own domain, e.g. "https://app.customer.com/".
VITE_PUBLIC_BASE=
